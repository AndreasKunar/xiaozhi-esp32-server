# Dockerfile-server-arm64
# Production image for ARM64 (Jetson Orin NX), containing only application code
FROM xiaozhi-esp32-server:server-base-arm64

# Copy application code
COPY main/xiaozhi-server .

# Expose the default ports used by the application
EXPOSE 8003 8000

# Start the application with proper signal handling
CMD ["python", "app.py"]